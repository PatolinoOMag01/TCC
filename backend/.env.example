# MySQL local. Na Railway, use as variáveis DB_* ligadas ao serviço MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=banco_interway
DB_USER=root
DB_PASSWORD=

# Gere uma chave exclusiva antes de iniciar a API:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Origens autorizadas para o navegador acessar a API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=

# O chat com IA depende de uma chave válida do OpenRouter.
OPENROUTER_API_KEY=

# Opcional: habilita checkout e notificações do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PLUS_DEMO_MODE=true
